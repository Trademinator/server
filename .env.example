APP_NAME=Trademinator
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
# Leave empty to use the bundled silver cyborg logo.
APP_LOGO_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=server
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Set MAIL_MAILER=mailgun when your sending domain and API key are ready.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun HTTP API. Use api.eu.mailgun.net for a domain in the EU region.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FEATURES_ENABLED=true
FEATURES_QUEUE_CHUNK_CANDLES=1000
COINGECKO_ENABLED=false
COINGECKO_API_KEY=
COINGECKO_PRO=false
COINGECKO_MAX_AGE_SECONDS=7200

# GDELT fork/event discovery through the open 15-minute GKG stream. No API key is required.
GDELT_ENABLED=true
GDELT_LASTUPDATE_URL=https://data.gdeltproject.org/gdeltv2/lastupdate.txt
GDELT_HTTP_TIMEOUT=30
GDELT_DOWNLOAD_TIMEOUT=60
GDELT_HTTP_CONNECT_TIMEOUT=5
GDELT_HTTP_ATTEMPTS=3
GDELT_RETRY_DELAY_MS=1000
GDELT_MAX_ARCHIVE_BYTES=16777216
GDELT_MAX_GKG_BYTES=134217728
GDELT_MINIMUM_CONFIDENCE=0.45

# Intelligence jobs: weekly and after history imports (drain with a cron worker)
INTELLIGENCE_ENABLED=true
INTELLIGENCE_QUEUE=intelligence
INTELLIGENCE_TOURNAMENT_QUEUE=tournament
# M5 intelligence selection. Accepted values: core, technical, full.
# Changing schema requires a fresh model build. full requires historical CoinGecko context.
INTELLIGENCE_SCHEMA=full
# Automatic pre-build Technical->Core / Full->Enhanced fallback on insufficient technical history.
INTELLIGENCE_TECHNICAL_FALLBACK=true
# core=15 OHLCV; technical=18 OHLCV; enhanced=core+optional CoinGecko; full=technical+optional CoinGecko.
# The previous 27-feature Full is retired. Rebuild old Full datasets/models.
INTELLIGENCE_COINGECKO_INSIGHT_ENABLED=false
# Begin in observation-only mode. Do not enable influence until separately validated.
INTELLIGENCE_COINGECKO_INFLUENCE_ENABLED=false
INTELLIGENCE_COINGECKO_MAX_WEIGHT=0.15
# Deprecated and ignored: CoinGecko no longer participates in KNN vectors.
# INTELLIGENCE_CONTEXT_FALLBACK=none
# Maximum training-history age at the build cutoff AND published model age, in days.
# Rebuild models after changing this window or the feature schema.
INTELLIGENCE_MAX_MODEL_AGE_DAYS=14
# M5 serving freshness/evidence gates. KNN settings are captured in each rebuilt model.
INTELLIGENCE_MAX_SIGNAL_AGE_PERIODS=2
INTELLIGENCE_MAX_SIGNAL_AGE_SECONDS=86400
INTELLIGENCE_MAX_SECONDS=1800
# Maximum dataset generation time, separate from the KNN training deadline.
RESEARCH_DATASET_MAX_SECONDS=540
INTELLIGENCE_KNN_MAX_DISTANCE=0.25
INTELLIGENCE_KNN_MIN_EFFECTIVE_NEIGHBORS=3.0
INTELLIGENCE_KNN_MIN_CONFIDENCE=0.60
INTELLIGENCE_OUTCOME_MIN_MACRO_F1=0.20
INTELLIGENCE_OUTCOME_MIN_BASELINE_IMPROVEMENT=0.02
INTELLIGENCE_OUTCOME_MIN_SUPPORTED_PREDICTIONS=25
INTELLIGENCE_OUTCOME_MIN_COVERAGE=0.01
HUMAN_TRAINING_ENABLED=true
HUMAN_TRAINING_TRAINER_UUIDS=
# Trend opinions stay outside model scoring; Candle annotations remain enabled.
HUMAN_TREND_TRAINING_ENABLED=false
HUMAN_CANDLE_TRAINING_ENABLED=true

# M5 Client API. Client trading remains off per market until explicitly enabled through the API.
CLIENT_API_ENABLED=true
CLIENT_API_RESPONSE_TTL_SECONDS=30
CLIENT_API_STATE_MAX_AGE_SECONDS=30
CLIENT_API_MAX_KEYS=10
CLIENT_PAPER_INITIAL_QUOTE=10000
CLIENT_DEFAULT_MAX_SIGNAL_DRIFT_BPS=100

# Older OHLCV history (drain this queue with a cron worker)
HISTORY_BACKFILL_ENABLED=true
HISTORY_BACKFILL_QUEUE=history
HISTORY_GAP_SCAN_INTERVAL_MINUTES=360
HISTORY_GAP_SCAN_MARKETS_PER_RUN=10
HISTORY_GAP_REPAIR_DISPATCH_LIMIT=20
HISTORY_GAP_EMPTY_ATTEMPTS_BEFORE_UNAVAILABLE=5
HISTORY_BACKFILL_MINIMUM_DAYS=7
HISTORY_BACKFILL_DEPTH_PROBE_CANDLES=12
HISTORY_BACKFILL_RESELECT_SHALLOW_PERIODS=true

# M7 shared OHLCV history cache. Redis failure falls back to DB/archive reads.
TICKER_HISTORY_CACHE_ENABLED=true
TICKER_HISTORY_CACHE_STORE=redis
TICKER_HISTORY_CACHE_TTL_SECONDS=30
TICKER_HISTORY_CACHE_MAX_ROWS=2000

# Automatic candle-period selection / reevaluation.
CANDLE_PERIOD_SELECTION_VERSION=4
CANDLE_PERIOD_QUALITY_THRESHOLD=0.7
CANDLE_PERIOD_MINIMUM_COVERAGE=0.8
CANDLE_PERIOD_MINIMUM_CANDLES=50
CANDLE_PERIOD_EVALUATION_DAYS=7
CANDLE_PERIOD_FALLBACK_DAYS=7
CANDLE_PERIOD_MINIMUM_ACTION_RATIO=0.02
# Maximum O=H=L=C candle share. A recent failed week cannot be masked by the 14-day fallback.
CANDLE_PERIOD_MAX_TRUE_FLAT_RATIO=0.10
# To return to a shorter period, all independent history windows must satisfy this tighter cap.
CANDLE_PERIOD_SHORTER_REENTRY_FLAT_RATIO=0.05
# 2 = newest 7 days and preceding 7 days by default; reevaluating twice is not a confirmation.
CANDLE_PERIOD_SHORTER_CONFIRMATION_WINDOWS=2
CANDLE_PERIOD_BACKFILL_RETRY_MINUTES=15
CANDLE_PERIOD_NO_CANDIDATE_RETRY_MINUTES=360
CANDLE_PERIOD_SCHEDULED_MARKETS_PER_RUN=10

LEAD_LAG_ENABLED=true
LEAD_LAG_DAILY_REFRESH=true

# Global server administration; an existing user's user_id (UUID), never an API key.
# Blank or invalid values grant no owner privilege. The owner must verify their email.
OWNER_UUID=
# Additional server owners, as comma-separated UUIDs (OWNER_UUID remains supported).
OWNER_UUIDS=
# Empty monitors all configured queue connections; optionally limit to comma-separated names.
OWNER_QUEUE_CONNECTIONS=

# Single-line operational events to the local syslog socket.
ACTION_SYSLOG_ENABLED=true
ACTION_SYSLOG_IDENT=trademinator
ACTION_SYSLOG_FACILITY=local0

# Local MaxMind GeoLite2 City / GeoIP2 City MMDB; no remote lookup service.
ACCESS_STATISTICS_ENABLED=true
ACCESS_STATISTICS_RETENTION_DAYS=90
GEOIP_DATABASE_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb
# Enable only when Laravel receives X-Forwarded-* headers from an HTTP reverse proxy.
# Leave false when directly exposed, or when the web server has already replaced
# REMOTE_ADDR from HAProxy/another proxy's PROXY protocol.
REVERSE_PROXY_ENABLED=false
# Required in production when reverse-proxy mode is enabled. Use only explicit,
# comma-separated proxy IPs/CIDRs. Never use *, **, REMOTE_ADDR or hostnames.
TRUSTED_PROXIES=

# M4.2 dashboard: record public Server observations; subscriptions never enable Client trading.
DASHBOARD_SIGNALS_ENABLED=true
# Uses the existing CoinGecko credentials; bounded discovery is refreshed hourly.
DASHBOARD_DISCOVERY_ENABLED=true

# M4.3 portable cold-history storage. Archives are not disaster-recovery backups.
ARCHIVE_ENABLED=true
ARCHIVE_PATH=/var/lib/trademinator/archive
ARCHIVE_GZIP_LEVEL=6
# Only complete months older than this boundary are exported by the scheduled pass.
ARCHIVE_AFTER_DAYS=90
# Multipart owner export/import. Parts are independently gzipped, verified and processed by queue workers.
ARCHIVE_PORTABLE_PATH=/var/lib/trademinator/portable
ARCHIVE_PORTABLE_QUEUE=archive
ARCHIVE_PORTABLE_PART_MAX_ROWS=10000
ARCHIVE_PORTABLE_PART_MAX_UNCOMPRESSED_MB=32
ARCHIVE_PORTABLE_PART_MAX_COMPRESSED_MB=64
ARCHIVE_PORTABLE_LINE_MAX_KB=1024
ARCHIVE_PORTABLE_MANIFEST_MAX_KB=2048
ARCHIVE_PORTABLE_MAX_PARTS=10000
ARCHIVE_PORTABLE_RETENTION_HOURS=24
