{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "trademinator/server",
    "type": "project",
    "description": "The Trademinator AI Server.",
    "keywords": [
        "laravel",
        "framework",
        "blade"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4 || ^8.5",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "ccxt/ccxt": "^4.5",
        "codeat3/blade-phosphor-icons": "^2.4",
        "jason-guru/laravel-make-repository": "^1.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "maxmind-db/reader": "^1.13.1",
        "pear/console_color2": "^0.1.2",
        "rubix/ml": "~3.1.0",
        "symfony/http-client": "^7.3",
        "symfony/mailgun-mailer": "^7.3",
        "trademinator/bcmath": "0.1.0",
        "trademinator/indicators": "0.1.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "files": [
            "app/Helpers/time.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php scripts/build-exchange-metadata.php --runtime"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
